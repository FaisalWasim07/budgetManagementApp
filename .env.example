# Postgres connection string.
#
# Local development: your own dev database, or a second free Supabase project.
# Never point this at the same database the deployed app uses — `npm run dev`
# would be editing your real budget.
DATABASE_URL=postgresql://user:password@host:5432/database

# A password inside a URL is percent-decoded, so a literal % in it is read as
# the start of an escape and the database receives something other than what
# you were given. Set the password here instead and it is used exactly as
# written — leave it out of DATABASE_URL entirely when you do:
#   DATABASE_URL=postgresql://user@host:5432/database
# DATABASE_PASSWORD=the password, verbatim

# --- TLS -------------------------------------------------------------------
# Supabase's poolers present a certificate from their own authority rather than
# a publicly trusted one, so connecting fails with SELF_SIGNED_CERT_IN_CHAIN
# until you pick one of these. Local connections don't use TLS and need neither.
#
# Preferred: the provider's CA certificate. Download it from Supabase under
# Settings -> Database -> SSL Configuration, and paste its contents here. The
# connection is encrypted *and* the server is proven to be the one you meant.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIF...\n-----END CERTIFICATE-----"
#
# Simpler: encrypt without checking who is on the other end.
# DATABASE_SSL_NO_VERIFY=true
