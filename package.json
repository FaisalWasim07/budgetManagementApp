{
  "name": "budget-management-app",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "postinstall": "npm run install:all",
    "db:init": "node server/src/db/init.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "migrate:sqlite": "node server/src/db/migrateFromSqlite.js",
    "db:test": "node server/src/db/testConnection.js",
    "reset-password": "node server/src/db/resetPassword.js",
    "test": "node test/run.js",
    "test:browser": "node test/browser/run.js",
    "push:keys": "node server/src/db/pushKeys.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "pg": "^8.23.0",
    "web-push": "^3.6.7"
  }
}
